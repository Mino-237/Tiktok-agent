# Kopiere diese Datei zu ".env" für lokale Tests und trage deine echten Keys ein.
# Für den Cloud-Betrieb (GitHub Actions) werden diese NICHT aus .env gelesen,
# sondern als "Secrets" im GitHub Repo hinterlegt (siehe README.md).
#
# WICHTIG: .env NIEMALS ins Git-Repo committen! Steht daher in .gitignore.

ANTHROPIC_API_KEY=sk-ant-...

DID_API_KEY=...
